# Image PHP consommee par les builds du serveur (FROM .../php:<tag> AS php_build, puis
# COPY --from=php_build /build/bin/php7). Elle ne contient que le PHP compile par compile.sh,
# avec les memes options que le workflow GitHub.
FROM ubuntu:22.04 AS build
ENV DEBIAN_FRONTEND=noninteractive

RUN apt-get update && apt-get install --no-install-recommends -y \
    make autoconf automake m4 gzip bzip2 bison g++ git cmake pkg-config re2c wget curl ca-certificates \
    libtool libtool-bin libffi-dev libc-bin xz-utils patch

WORKDIR /build
COPY compile.sh ./

ARG THREADS=4
ARG PHP_VERSION_BASE=8.4
RUN ./compile.sh -t linux64 -j ${THREADS} -g -F -P 5 -w 4096 -D -z ${PHP_VERSION_BASE} || (tail -n 80 install.log; exit 1)
RUN ./bin/php7/bin/php -r 'foreach(["chunkutils2", "encoding", "igbinary", "leveldb", "morton", "pmmpthread", "yaml", "zlib", "FFI"] as $e){ if(!extension_loaded($e)){ fwrite(STDERR, "extension manquante : $e\n"); exit(1); } } echo "PHP ", PHP_VERSION, ", chunkutils2 ", phpversion("chunkutils2"), "\n";'

FROM ubuntu:22.04
COPY --from=build /build/bin /build/bin
RUN /build/bin/php7/bin/php -r 'echo "PHP ", PHP_VERSION, ", curl ", curl_version()["version"], "\n";'
